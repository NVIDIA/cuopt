<!--
  SPDX-FileCopyrightText: Copyright (c) 2026, NVIDIA CORPORATION & AFFILIATES. All rights reserved.
  SPDX-License-Identifier: Apache-2.0

  Build setup notes:

    - Java 21 base API (src/main/java/) + Java 22 multi-release JAR for FFM
      implementation (src/main/java22/). Public API loads on Java 21
      classpaths; runtime requires Java 22+. (cuvs Issue #1066.)

    - maven-compiler-plugin 3.11.0+ with explicit phase bindings: the two
      compile executions are bound to 'compile' and 'process-classes'
      respectively to force serial execution. Without this, the java22
      compile starts before the default compile finishes about half the
      time, producing phantom 'cannot find symbol' errors. (cuvs Issue #1293.)

    - Spotless (when added in a follow-up PR) goes ONLY under
      <build><plugins>, never under <dependencies>. Listing it as a
      dependency packs spotless into a fat JAR with multiple
      module-info.class files. (cuvs Issue #1090.)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nvidia.cuopt</groupId>
    <artifactId>cuopt-java</artifactId>
    <version>26.6.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>cuopt-java</name>
    <description>Java interface to NVIDIA cuOpt for LP, MILP, and QP.</description>
    <url>https://github.com/NVIDIA/cuopt</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Default release is Java 22 (the runtime requirement); per-execution
             release overrides on maven-compiler-plugin pin Java 21 for the
             public API source set. -->
        <maven.compiler.source>22</maven.compiler.source>
        <maven.compiler.target>22</maven.compiler.target>

        <junit.jupiter.version>5.11.4</junit.jupiter.version>
    </properties>

    <dependencies>
        <!-- NO runtime dependencies. NO build-only deps in this section
             (e.g., spotless, when added later, lives in <build><plugins>). -->

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiler: Java 21 release for src/main/java, Java 22 release for src/main/java22.
                 Phase binding to 'compile' and 'process-classes' forces serial execution. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <release>21</release>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/java</compileSourceRoot>
                            </compileSourceRoots>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-java-22</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <release>22</release>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/java22</compileSourceRoot>
                            </compileSourceRoots>
                            <multiReleaseOutput>true</multiReleaseOutput>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- JAR: Multi-Release manifest entry. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Multi-Release>true</Multi-Release>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- Surefire: runs *Test.java (pure-Java unit tests).
                 Tests that exercise the FFM impl live in *IT.java and
                 are run by Failsafe against the packaged JAR — see note
                 on Multi-Release JAR semantics below. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>

            <!-- Failsafe: runs *IT.java integration tests.
                 Multi-Release JAR semantics (META-INF/versions/22/) are
                 only honored when classes are loaded from an actual JAR
                 file, NOT from exploded target/classes/. So integration
                 tests that exercise the Java 22 FFM impl must run
                 against the packaged JAR. We achieve this by setting
                 classesDirectory to the JAR path; Failsafe runs in the
                 integration-test phase, after package, so the JAR exists. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                    <classesDirectory>${project.build.directory}/${project.build.finalName}.jar</classesDirectory>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
      Profiles for the per-(arch, cuda) classifier JAR (mirrors cuvs's
      pattern). The base JAR (no classifier) is always produced and uses
      System.loadLibrary at runtime ("BYO libcuopt" mode). The classifier
      JAR additionally bundles libcuopt + sibling RAPIDS deps and carries
      the manifest entry Embedded-Libraries-Cuda-Version so the loader
      can detect it.

      Activation:
        mvn package -Dcuda.version=13           # builds base + classifier
        mvn package                             # builds base only

      Native lib sources:
        libcuopt.so       — ${native.cpp.build.path}/libcuopt.so
        libmps_parser.so  — ${native.cpp.build.path}/libmps_parser/libmps_parser.so
        librmm.so         — ${env.CONDA_PREFIX}/lib/librmm.so
        librapids_logger  — ${env.CONDA_PREFIX}/lib/librapids_logger.so

      CONDA_PREFIX must be set during the classifier build (active conda
      env). CI does this via ci/build_java.sh which activates the conda
      environment before running mvn.

      Excluded bundled libs (see issue #1203 — static-linking follow-up):
        - CUDA toolkit libs (size + license)
        - gRPC, protobuf, abseil (ABI-unstable, global-state risk)
        - TBB, libgomp (global runtimes)
        - libstdc++, libgcc_s (system ABI)
    -->
    <profiles>

        <profile>
            <id>arch-amd64</id>
            <activation>
                <os>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <native.arch>x86_64</native.arch>
            </properties>
        </profile>

        <profile>
            <id>arch-aarch64</id>
            <activation>
                <os>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <native.arch>aarch64</native.arch>
            </properties>
        </profile>

        <profile>
            <id>classifier-jar</id>
            <activation>
                <property>
                    <name>cuda.version</name>
                </property>
            </activation>
            <properties>
                <native.classifier>${native.arch}-cuda${cuda.version}</native.classifier>
                <native.cpp.build.path>${project.basedir}/../../cpp/build</native.cpp.build.path>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>copy-cuopt-libs</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <overwrite>true</overwrite>
                                    <outputDirectory>${project.build.directory}/native-libs/${os.arch}/${os.name}</outputDirectory>
                                    <!-- Two possible layouts for libcuopt + libmps_parser:
                                           A. Flat (CONDA / installed):       $native.cpp.build.path/{libcuopt.so, libmps_parser.so}
                                           B. Nested (local cpp/build dev):   $native.cpp.build.path/libcuopt.so
                                                                              $native.cpp.build.path/libmps_parser/libmps_parser.so
                                         Maven warns and skips non-existent <directory> entries, so listing
                                         both layouts is safe — whichever exists wins. -->
                                    <resources>
                                        <resource>
                                            <directory>${native.cpp.build.path}</directory>
                                            <includes>
                                                <include>libcuopt.so</include>
                                                <include>libmps_parser.so</include>
                                            </includes>
                                        </resource>
                                        <resource>
                                            <directory>${native.cpp.build.path}/libmps_parser</directory>
                                            <includes>
                                                <include>libmps_parser.so</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                            <execution>
                                <id>copy-rapids-libs</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <overwrite>true</overwrite>
                                    <outputDirectory>${project.build.directory}/native-libs/${os.arch}/${os.name}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${env.CONDA_PREFIX}/lib</directory>
                                            <includes>
                                                <include>librmm.so</include>
                                                <include>librapids_logger.so</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <version>3.7.1</version>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/native-with-deps.xml</descriptor>
                            </descriptors>
                            <archive>
                                <manifestEntries>
                                    <Multi-Release>true</Multi-Release>
                                    <Embedded-Libraries-Cuda-Version>${cuda.version}</Embedded-Libraries-Cuda-Version>
                                </manifestEntries>
                            </archive>
                        </configuration>
                        <executions>
                            <execution>
                                <id>assemble-native</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

    </profiles>
</project>
