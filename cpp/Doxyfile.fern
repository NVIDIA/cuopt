# Doxyfile for Fern library docs generator.
# Paths are relative to the input.path directory (cpp/) as required by
# `fern docs md generate --local`.
# This is a trimmed version of cpp/doxygen/Doxyfile with adjusted INPUT paths.

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "libcuopt"
PROJECT_BRIEF          = "NVIDIA cuOpt C API reference"
OUTPUT_DIRECTORY       =
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
FULL_PATH_NAMES        = NO
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
EXTENSION_MAPPING      = cu=C++ cuh=C++ h=C c=C
OPTIMIZE_OUTPUT_FOR_C  = YES

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = YES

# Input paths relative to input.path (cpp/ directory)
INPUT                  = doxygen/main_page.md \
                         include/cuopt/mathematical_optimization/cuopt_c.h \
                         include/cuopt/mathematical_optimization/constants.h

INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h *.c
RECURSIVE              = NO
EXCLUDE_PATTERNS       = */nvtx/* */nvstrings/*

GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = YES
